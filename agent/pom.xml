<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.godardstack</groupId>
    <artifactId>godard-stack-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>0.14.0</version>
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.10</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.19</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>godard-stack-agent</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>com/sun/jna/aix-*/**</exclude>
                                        <exclude>com/sun/jna/sunos-*/**</exclude>
                                        <exclude>com/sun/jna/freebsd-*/**</exclude>
                                        <exclude>com/sun/jna/openbsd-*/**</exclude>
                                        <exclude>com/sun/jna/dragonflybsd-*/**</exclude>
                                        <exclude>com/sun/jna/linux-arm/**</exclude>
                                        <exclude>com/sun/jna/linux-armel/**</exclude>
                                        <exclude>com/sun/jna/linux-loongarch64/**</exclude>
                                        <exclude>com/sun/jna/linux-mips64el/**</exclude>
                                        <exclude>com/sun/jna/linux-ppc/**</exclude>
                                        <exclude>com/sun/jna/linux-ppc64le/**</exclude>
                                        <exclude>com/sun/jna/linux-riscv64/**</exclude>
                                        <exclude>com/sun/jna/linux-s390x/**</exclude>
                                        <exclude>com/sun/jna/linux-x86/**</exclude>
                                        <exclude>com/sun/jna/win32-x86/**</exclude>
                                        <exclude>resources/com/pty4j/native/freebsd/**</exclude>
                                        <exclude>resources/com/pty4j/native/linux/arm/**</exclude>
                                        <exclude>resources/com/pty4j/native/linux/mips64el/**</exclude>
                                        <exclude>resources/com/pty4j/native/linux/ppc64le/**</exclude>
                                        <exclude>resources/com/pty4j/native/linux/riscv64/**</exclude>
                                        <exclude>resources/com/pty4j/native/linux/x86/**</exclude>
                                        <exclude>resources/com/pty4j/native/win/x86/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.godardstack.agent.AgentApplication</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
