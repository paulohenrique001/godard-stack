{
  "name": "godard-stack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "backend:verify": "JAVA_HOME=${JAVA_HOME:-/home/paulo-henrique/.jdks/corretto-21.0.11} mvn -B -Dmaven.repo.local=build/maven-repository -f backend/pom.xml verify",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "prepare:resources": "node scripts/prepare-desktop-resources.mjs",
    "desktop:dev": "npm run backend:verify && TAURI_CONFIG='{\"bundle\":{\"resources\":[]}}' tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "format": "npm run format:backend && npm run format:frontend",
    "format:backend": "JAVA_HOME=${JAVA_HOME:-/home/paulo-henrique/.jdks/corretto-21.0.11} mvn -B -Dmaven.repo.local=build/maven-repository -f backend/pom.xml spotless:apply",
    "format:check": "npm run format:backend:check && npm run format:frontend:check",
    "format:backend:check": "JAVA_HOME=${JAVA_HOME:-/home/paulo-henrique/.jdks/corretto-21.0.11} mvn -B -Dmaven.repo.local=build/maven-repository -f backend/pom.xml spotless:check",
    "format:frontend": "npm --prefix frontend run format",
    "format:frontend:check": "npm --prefix frontend run format:check",
    "dev:reset": "APP=$HOME/.local/share/com.katomus.godardstack && rm -f $APP/data/godard-stack.db $APP/data/godard-stack.db-wal $APP/data/godard-stack.db-shm $APP/secrets/connection.key $APP/runtime/ready-*.json && echo 'Dev reset concluído.'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-updater": "2.12.0"
  }
}
